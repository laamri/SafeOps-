# Copy to .env and replace every placeholder before starting the stack.
# These values are development-only examples, not production credentials.

# Host ports (bound to loopback)
KEYCLOAK_PORT=8080
GATEWAY_PORT=8888
FRONTEND_PORT=3000
FRONTEND_DEV_PORT=5173

# Keycloak master admin
KC_ADMIN=admin
KC_ADMIN_PASSWORD=replace-with-local-keycloak-admin-password

# PostgreSQL bootstrap superuser and initial database
POSTGRES_SUPERUSER=postgres
POSTGRES_SUPERUSER_PASSWORD=replace-with-local-postgres-superuser-password
POSTGRES_BOOTSTRAP_DB=postgres

# Per-service databases and credentials
QUEUE_DB_NAME=tiko
QUEUE_DB_USER=tiko
QUEUE_DB_PASSWORD=replace-with-local-queue-database-password

APPOINTMENTS_DB_NAME=appointments
APPOINTMENTS_DB_USER=appointments
APPOINTMENTS_DB_PASSWORD=replace-with-local-appointments-database-password

PROFILES_DB_NAME=profiles
PROFILES_DB_USER=profile_notifications
PROFILES_DB_PASSWORD=replace-with-local-profiles-database-password

# Test accounts created in realm "tiko" by keycloak/bootstrap.sh
# Usernames: client (client role), agent (agent role), admin (admin + agent roles)
TIKO_CLIENT_PASSWORD=replace-with-local-client-password
TIKO_AGENT_PASSWORD=replace-with-local-agent-password
TIKO_ADMIN_PASSWORD=replace-with-local-test-admin-password

# Optional loopback-only ports enabled by docker-compose.debug.yml
POSTGRES_DEBUG_PORT=55432
QUEUE_SERVICE_DEBUG_PORT=18081
APPOINTMENT_SERVICE_DEBUG_PORT=18082
PROFILE_SERVICE_DEBUG_PORT=18083
