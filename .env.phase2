# Copy to .env and replace every placeholder before starting the stack.
# These values are development-only examples, not production credentials.

# Host ports (bound to loopback)
KEYCLOAK_PORT=18080
GATEWAY_PORT=18888
FRONTEND_PORT=13000
FRONTEND_DEV_PORT=15173

# Keycloak master admin
KC_ADMIN=admin
KC_ADMIN_PASSWORD=local-kc-admin

# PostgreSQL bootstrap superuser and initial database
POSTGRES_SUPERUSER=postgres
POSTGRES_SUPERUSER_PASSWORD=local-postgres
POSTGRES_BOOTSTRAP_DB=postgres

# Per-service databases and credentials
QUEUE_DB_NAME=tiko
QUEUE_DB_USER=tiko
QUEUE_DB_PASSWORD=local-queue

APPOINTMENTS_DB_NAME=appointments
APPOINTMENTS_DB_USER=appointments
APPOINTMENTS_DB_PASSWORD=local-appointments

PROFILES_DB_NAME=profiles
PROFILES_DB_USER=profile_notifications
PROFILES_DB_PASSWORD=local-profiles

TENANTS_DB_NAME=tenants
TENANTS_DB_USER=tenants
TENANTS_DB_PASSWORD=local-tenants

# Test accounts created in realm "tiko" by keycloak/bootstrap.sh.
# client is global; agent-a/admin-a use tenant-a; agent-b/admin-b use tenant-b.
TIKO_CLIENT_PASSWORD=local-client
TIKO_TENANT_A_AGENT_PASSWORD=local-agent-a
TIKO_TENANT_A_ADMIN_PASSWORD=local-admin-a
TIKO_TENANT_B_AGENT_PASSWORD=local-agent-b
TIKO_TENANT_B_ADMIN_PASSWORD=local-admin-b
TIKO_PROVIDER_ADMIN_PASSWORD=local-provider

# Optional loopback-only ports enabled by docker-compose.debug.yml
POSTGRES_DEBUG_PORT=55432
QUEUE_SERVICE_DEBUG_PORT=18081
APPOINTMENT_SERVICE_DEBUG_PORT=18082
PROFILE_SERVICE_DEBUG_PORT=18083
